FROM docker.io/library/debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

ARG IMAGE_CREATED
ARG IMAGE_REVISION
ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="OpenLDAP Declarative Snapshot Generator"
LABEL org.opencontainers.image.description="Build tool for signed, service-specific OpenLDAP snapshots"
LABEL org.opencontainers.image.vendor="foundata GmbH"
LABEL org.opencontainers.image.source="https://github.com/foundata/oci-openldap-declarative"
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"
LABEL org.opencontainers.image.base.name="docker.io/library/debian:13-slim"
LABEL org.opencontainers.image.created="${IMAGE_CREATED}"
LABEL org.opencontainers.image.revision="${IMAGE_REVISION}"
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    minisign \
    python3 \
    python3-argon2 \
    python3-ldap \
    python3-yaml \
  && find /usr/share/doc -type f ! -name copyright -delete \
  && find /usr/share/doc -type l -delete \
  && find /usr/share/doc -depth -type d -empty -delete \
  && install -d -m 0755 /usr/local/share/openldap-declarative \
  && dpkg-query -W -f='${Package}\t${Version}\n' \
    > /usr/local/share/openldap-declarative/package-versions.unsorted \
  && sort /usr/local/share/openldap-declarative/package-versions.unsorted \
    > /usr/local/share/openldap-declarative/package-versions.txt \
  && rm /usr/local/share/openldap-declarative/package-versions.unsorted \
  && rm -rf \
    /usr/share/man/* \
    /var/lib/apt/lists/* \
  && if getent passwd 1001 >/dev/null || getent group 1001 >/dev/null; then \
    printf '%s\n' 'UID or GID 1001 already exists in the pinned base image' >&2; \
    exit 1; \
  fi \
  && groupadd --gid 1001 openldap-generator \
  && useradd --uid 1001 --gid 1001 --home-dir /nonexistent \
    --no-create-home --shell /usr/sbin/nologin openldap-generator \
  && install -d -o openldap-generator -g openldap-generator -m 0700 /output \
  && install -d -o root -g root -m 0555 /input /run/credentials

COPY --chown=0:0 --chmod=0555 generator/generate.py /usr/local/bin/openldap-snapshot-generator
COPY --chown=0:0 --chmod=0444 LICENSES/GPL-3.0-or-later.txt /usr/local/share/openldap-declarative/LICENSE.txt

USER 1001:1001

ENTRYPOINT ["/usr/local/bin/openldap-snapshot-generator"]
