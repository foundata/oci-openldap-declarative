FROM docker.io/library/debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132 AS schema-builder

ARG DEBIAN_FRONTEND=noninteractive

COPY --chown=0:0 --chmod=0444 generator/export_schema.py /tmp/export_schema.py

RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
  && chmod 0755 /usr/sbin/policy-rc.d \
  && apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-ldap slapd \
  && install -d -m 0755 /export/schema \
  && install -d -m 0755 /export/available \
  && install -m 0444 /etc/ldap/schema/*.ldif /export/available/ \
  && python3 /tmp/export_schema.py /export/schema \
  && install -m 0444 /usr/share/doc/slapd/copyright /export/copyright \
  && dpkg-query -W -f='${Version}\n' slapd > /export/schema/openldap-version \
  && rm -rf /var/lib/apt/lists/*

FROM docker.io/library/debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

ARG IMAGE_CREATED
ARG IMAGE_REVISION
ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="OpenLDAP Declarative Snapshot Generator"
LABEL org.opencontainers.image.description="Build tool for signed OpenLDAP directory snapshots"
LABEL org.opencontainers.image.vendor="foundata GmbH"
LABEL org.opencontainers.image.source="https://foundata.com/en/projects/oci-openldap-declarative/#source"
LABEL org.opencontainers.image.url="https://foundata.com/en/projects/oci-openldap-declarative/"
LABEL org.opencontainers.image.documentation="https://foundata.com/en/projects/oci-openldap-declarative/#doc"
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"
LABEL org.opencontainers.image.base.name="docker.io/library/debian:13-slim"
LABEL org.opencontainers.image.created="${IMAGE_CREATED}"
LABEL org.opencontainers.image.revision="${IMAGE_REVISION}"
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ansible-core \
    libssl3t64 \
    minisign \
    openssl \
    openssl-provider-legacy \
    python3 \
    python3-argon2 \
    python3-ldap \
    python3-yaml \
  && find /usr/share/doc -type f ! -name copyright -delete \
  && find /usr/share/doc -type l -delete \
  && find /usr/share/doc -depth -type d -empty -delete \
  && install -d -m 0755 /usr/local/share/openldap-declarative \
  && dpkg-query -W -f='${Package}\t${Version}\n' \
    > /usr/local/share/openldap-declarative/package-versions.unsorted \
  && sort /usr/local/share/openldap-declarative/package-versions.unsorted \
    > /usr/local/share/openldap-declarative/package-versions.txt \
  && rm /usr/local/share/openldap-declarative/package-versions.unsorted \
  && rm -rf \
    /usr/share/man/* \
    /var/lib/apt/lists/* \
  && if getent passwd 1001 >/dev/null || getent group 1001 >/dev/null; then \
    printf '%s\n' 'UID or GID 1001 already exists in the pinned base image' >&2; \
    exit 1; \
  fi \
  && groupadd --gid 1001 openldap-generator \
  && useradd --uid 1001 --gid 1001 --home-dir /nonexistent \
    --no-create-home --shell /usr/sbin/nologin openldap-generator \
  && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
  && install -d -o openldap-generator -g openldap-generator -m 0700 /output \
  && install -d -o root -g root -m 0555 /input /run/credentials

ENV PYTHONPATH="/usr/local/lib/openldap-declarative" \
    TMPDIR="/output" \
    PYTHONDONTWRITEBYTECODE="1"

COPY --chown=0:0 --chmod=0444 generator/generate.py /usr/local/lib/openldap-declarative/generator/generate.py
COPY --chown=0:0 --chmod=0444 generator/extensions.py /usr/local/lib/openldap-declarative/generator/extensions.py
COPY --chown=0:0 --chmod=0444 schema/application-user.ldif /usr/local/share/openldap-declarative/schema/application-user.ldif
COPY --from=schema-builder --chown=0:0 --chmod=0444 /export/schema/ /usr/local/share/openldap-declarative/schema/
COPY --from=schema-builder --chown=0:0 --chmod=0444 /export/available/ /usr/local/share/openldap-declarative/schema/available/
COPY --from=schema-builder --chown=0:0 --chmod=0444 /export/copyright /usr/share/doc/slapd-schema/copyright
COPY --chown=0:0 --chmod=0555 generator/password.py /usr/local/bin/openldap-password
COPY --chown=0:0 --chmod=0444 generator/vault.py /usr/local/lib/openldap-declarative/generator/vault.py
COPY --chown=0:0 --chmod=0444 scripts/directory_data.py /usr/local/lib/openldap-declarative/scripts/directory_data.py
COPY --chown=0:0 --chmod=0444 scripts/server_config.py /usr/local/lib/openldap-declarative/scripts/server_config.py
COPY --chown=0:0 --chmod=0444 LICENSES/GPL-3.0-or-later.txt /usr/local/share/openldap-declarative/LICENSE.txt

USER 1001:1001

ENTRYPOINT ["/usr/bin/python3", "-m", "generator.generate"]
