# ============================================================================
# Application bind accounts
#
# NOTE: @BASE_DN@, @ORGANISATION@, and @FIRST_DC@ are substituted at runtime
#       during container startup (load-ldif.sh). This behavior id not part of
#       built-in LDIF or OpenLDAP functionality.
#
# Applications should NOT bind as cn=admin. Instead, they get dedicated service
# accounts with minimal permissions (as defined in ACLs).
#
# Security model (see ACLs):
#
# - Service accounts can authenticate users (bind with user's password)
# - Service accounts can read user attributes needed for the app
# - Service accounts can read group memberships
# - Service accounts CANNOT modify anything
# - Service accounts CANNOT read other service account passwords
#
# Object classes used:
# - organizationalRole: Provides cn (common name)
# - simpleSecurityObject: Provides userPassword attribute
#
# This combination creates a "technical account" that:
# - Can bind to LDAP
# - Cannot be confused with a human user (not inetOrgPerson)
# - Has minimal attributes
#
# Generate passwords with: slappasswd -h {SSHA}
#
# Manual apply: ldapadd -x -H ldap:/// -D "cn=admin,@BASE_DN@" -W -f <filename>
# ============================================================================

# ----------------------------------------------------------------------------
# Nextcloud Service Account
# ----------------------------------------------------------------------------
dn: cn=nextcloud,ou=services,@BASE_DN@
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: nextcloud
description: Nextcloud LDAP bind account
# Generate with: slappasswd -h {SSHA} -s "your-secure-password"
userPassword: {SSHA}REPLACE_WITH_GENERATED_HASH

# ----------------------------------------------------------------------------
# Mattermost Service Account
# ----------------------------------------------------------------------------
dn: cn=mattermost,ou=services,@BASE_DN@
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: mattermost
description: Mattermost LDAP bind account
userPassword: {SSHA}REPLACE_WITH_GENERATED_HASH

# ----------------------------------------------------------------------------
# GitLab Service Account (example)
# ----------------------------------------------------------------------------
dn: cn=gitlab,ou=services,@BASE_DN@
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: gitlab
description: GitLab LDAP bind account
userPassword: {SSHA}REPLACE_WITH_GENERATED_HASH

# ============================================================================
# Ansible Template Example:
# ============================================================================
# {% for svc in ldap_service_accounts %}
# dn: cn={{ svc.name }},ou=services,{{ ldap_base_dn }}
# objectClass: organizationalRole
# objectClass: simpleSecurityObject
# cn: {{ svc.name }}
# description: {{ svc.description }}
# userPassword: {{ svc.password_hash }}
#
# {% endfor %}
# ============================================================================
