[Unit]
Description=Check the application-local OpenLDAP directory independently
Documentation=https://foundata.com/en/projects/oci-openldap-declarative/#doc

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
RandomizedDelaySec=15s
AccuracySec=5s
Unit=openldap-example-backstop.service

[Install]
WantedBy=timers.target
