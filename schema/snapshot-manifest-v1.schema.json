{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundata.com/schemas/openldap-snapshot-manifest-v1.schema.json",
  "title": "OpenLDAP declarative snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "directory_id",
    "base_dn",
    "revision",
    "generated_at",
    "soft_expires_at",
    "expires_at",
    "uuid_namespace",
    "files",
    "input_type"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "directory_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "base_dn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "soft_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "uuid_namespace": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.ldif$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "data",
              "schema",
              "config"
            ]
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "data"
          }
        }
      }
    },
    "input_type": {
      "enum": [
        "users-groups",
        "ldif"
      ]
    },
    "read_attributes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^([A-Za-z][A-Za-z0-9-]*|[0-9]+(\\.[0-9]+)+)$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "input_type": {
            "const": "ldif"
          }
        }
      },
      "then": {
        "not": {"required": ["read_attributes"]},
        "properties": {
          "files": {
            "items": {
              "properties": {
                "kind": {"enum": ["data", "config"]}
              }
            },
            "contains": {
              "properties": {
                "kind": {"const": "config"}
              }
            },
            "minContains": 1,
            "maxContains": 1
          },
          "uuid_namespace": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": ["read_attributes"],
        "properties": {
          "files": {
            "items": {
              "properties": {
                "kind": {"enum": ["data", "schema"]}
              }
            }
          },
          "uuid_namespace": {
            "type": "string"
          }
        }
      }
    }
  ]
}
