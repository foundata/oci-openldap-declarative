{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundata.com/schemas/openldap-credentials-v1.schema.json",
  "title": "OpenLDAP declarative credential references",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "users",
    "services"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "users": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/sourceId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/userCredential"
      }
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/serviceId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/serviceCredential"
      }
    }
  },
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "maxLength": 4096
    },
    "userCredential": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "password_file"
          ]
        },
        {
          "required": [
            "service_password_files"
          ]
        }
      ],
      "properties": {
        "password_file": {
          "$ref": "#/$defs/absolutePath"
        },
        "service_password_files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/serviceId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/absolutePath"
          }
        }
      }
    },
    "serviceCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bind_password_file"
      ],
      "properties": {
        "bind_password_file": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    }
  }
}
