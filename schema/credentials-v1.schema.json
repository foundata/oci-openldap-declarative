{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundata.com/schemas/openldap-credentials-v1.schema.json",
  "title": "OpenLDAP declarative credential sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "users",
    "services"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "users": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/sourceId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/userCredential"
      }
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/serviceId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/serviceCredential"
      }
    }
  },
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000\\r\\n]+$",
      "maxLength": 4096
    },
    "passwordHash": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^\\{ARGON2\\}\\$argon2id\\$v=19\\$m=[1-9][0-9]*,t=[1-9][0-9]*,p=[1-9][0-9]*\\$[A-Za-z0-9+/]+\\$[A-Za-z0-9+/]+$",
      "description": "An OpenLDAP Argon2id verifier. The generator also checks cost parameters, salt/digest lengths and canonical base64 encoding."
    },
    "serviceFileMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/serviceId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/absolutePath"
      }
    },
    "serviceHashMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/serviceId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/passwordHash"
      }
    },
    "userCredential": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "password_file"
          ]
        },
        {
          "required": [
            "service_password_files"
          ]
        },
        {
          "required": [
            "password_hash_file"
          ]
        },
        {
          "required": [
            "password_hash"
          ]
        },
        {
          "required": [
            "service_password_hash_files"
          ]
        },
        {
          "required": [
            "service_password_hashes"
          ]
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "password_file",
              "password_hash_file"
            ]
          },
          {
            "required": [
              "password_file",
              "password_hash"
            ]
          },
          {
            "required": [
              "password_hash_file",
              "password_hash"
            ]
          }
        ]
      },
      "properties": {
        "password_file": {
          "$ref": "#/$defs/absolutePath"
        },
        "password_hash_file": {
          "$ref": "#/$defs/absolutePath"
        },
        "password_hash": {
          "$ref": "#/$defs/passwordHash"
        },
        "service_password_files": {
          "$ref": "#/$defs/serviceFileMap"
        },
        "service_password_hash_files": {
          "$ref": "#/$defs/serviceFileMap"
        },
        "service_password_hashes": {
          "$ref": "#/$defs/serviceHashMap"
        }
      }
    },
    "serviceCredential": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "bind_password_file"
          ]
        },
        {
          "required": [
            "bind_password_hash_file"
          ]
        },
        {
          "required": [
            "bind_password_hash"
          ]
        }
      ],
      "properties": {
        "bind_password_file": {
          "$ref": "#/$defs/absolutePath"
        },
        "bind_password_hash_file": {
          "$ref": "#/$defs/absolutePath"
        },
        "bind_password_hash": {
          "$ref": "#/$defs/passwordHash"
        }
      }
    }
  }
}
