{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundata.com/schemas/openldap-directory-v1.schema.json",
  "title": "One OpenLDAP directory definition (validate after Vault decryption)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "directory_id",
    "base_dn",
    "revision",
    "soft_ttl_seconds",
    "hard_ttl_seconds",
    "input_type"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "directory_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "base_dn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "soft_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "hard_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "expiry_offset_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "input_type": {
      "enum": [
        "users-groups",
        "ldif"
      ]
    },
    "schema_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000\\r\\n]+$"
      },
      "minItems": 0,
      "maxItems": 31,
      "uniqueItems": true
    },
    "read_attributes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^([A-Za-z][A-Za-z0-9-]*|[0-9]+(\\.[0-9]+)+)$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "entry_uuid": {
      "$ref": "#/$defs/entryUuid",
      "description": "Stable base-entry UUID; also the namespace for generated OU UUIDs."
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "users": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/user"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "ldif_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000\\r\\n]+$"
      },
      "minItems": 1,
      "maxItems": 31,
      "uniqueItems": true
    },
    "config_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000\\r\\n]+$"
      },
      "description": "Complete custom cn=config entries, including schemas, in import order."
    },
    "bind_accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bindAccount"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "input_type": {
          "const": "users-groups"
        }
      },
      "required": [
        "entry_uuid",
        "organization",
        "users",
        "groups",
        "bind_accounts"
      ],
      "not": {
        "anyOf": [
          {"required": ["ldif_files"]},
          {"required": ["config_files"]}
        ]
      }
    },
    {
      "properties": {
        "input_type": {
          "const": "ldif"
        }
      },
      "required": [
        "ldif_files",
        "config_files"
      ],
      "not": {
        "anyOf": [
          {"required": ["read_attributes"]},
          {"required": ["schema_files"]},
          {
            "required": [
              "entry_uuid"
            ]
          },
          {
            "required": [
              "organization"
            ]
          },
          {
            "required": [
              "users"
            ]
          },
          {
            "required": [
              "groups"
            ]
          },
          {
            "required": [
              "bind_accounts"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "entryUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "description": "Permanent LDAP entryUUID, unique across the entire directory. Generate a UUIDv4 once and retain it across renames and rebuilds."
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+(?![\\s\\S])",
      "description": "LDAP displayName and cn; when omitted, cn uses username."
    },
    "extraAttributes": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/ldapIdentifier"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+(?![\\s\\S])"
        }
      },
      "description": "Additional user attributes; generated and dedicated profile attributes are reserved. Schema-aware checks follow parsing."
    },
    "ldapIdentifier": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^([A-Za-z][A-Za-z0-9-]*|[0-9]+(\\.[0-9]+)+)(?![\\s\\S])"
    },
    "extraObjectClasses": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ldapIdentifier"
      },
      "description": "Additional auxiliary classes only; structural classes, generated duplicates and extensibleObject are rejected."
    },
    "credentialValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "credentialPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000\\r\\n]+$"
    },
    "passwordSource": {
      "oneOf": [
        {
          "required": [
            "password"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password_file"
                ]
              },
              {
                "required": [
                  "password_hash"
                ]
              },
              {
                "required": [
                  "password_hash_file"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "password_file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password"
                ]
              },
              {
                "required": [
                  "password_hash"
                ]
              },
              {
                "required": [
                  "password_hash_file"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "password_hash"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password"
                ]
              },
              {
                "required": [
                  "password_file"
                ]
              },
              {
                "required": [
                  "password_hash_file"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "password_hash_file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password"
                ]
              },
              {
                "required": [
                  "password_file"
                ]
              },
              {
                "required": [
                  "password_hash"
                ]
              }
            ]
          }
        }
      ]
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_uuid",
        "username",
        "last_name",
        "active"
      ],
      "properties": {
        "attributes": {
          "$ref": "#/$defs/extraAttributes"
        },
        "object_classes": {
          "$ref": "#/$defs/extraObjectClasses"
        },
        "entry_uuid": {
          "$ref": "#/$defs/entryUuid"
        },
        "username": {
          "$ref": "#/$defs/username"
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP sn (surname) attribute."
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP mail attribute."
        },
        "active": {
          "type": "boolean"
        },
        "password": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_file": {
          "$ref": "#/$defs/credentialPath"
        },
        "password_hash": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_hash_file": {
          "$ref": "#/$defs/credentialPath"
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP givenName attribute."
        },
        "initials": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP initials attribute."
        },
        "display_name": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP description attribute."
        },
        "office": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP physicalDeliveryOfficeName attribute."
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP telephoneNumber attribute."
        },
        "mobile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP mobile attribute."
        },
        "org": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP o attribute on the user; does not change the DN."
        },
        "employee_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP employeeNumber attribute; independent of username and entry_uuid."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP ou attribute."
        },
        "job_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP title attribute."
        },
        "proxy_addresses": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1123,
            "pattern": "^[A-Za-z][A-Za-z0-9]*:[^\\s\\u0000\\r\\n](?:[^\\u0000\\r\\n]*[^\\s\\u0000\\r\\n])?$"
          },
          "description": "Typed recipient addresses; case-insensitive duplicates are rejected."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "active": {
                "const": true
              }
            }
          },
          "then": {
            "$ref": "#/$defs/passwordSource"
          },
          "else": {
            "anyOf": [
              {
                "$ref": "#/$defs/passwordSource"
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "password"
                      ]
                    },
                    {
                      "required": [
                        "password_file"
                      ]
                    },
                    {
                      "required": [
                        "password_hash"
                      ]
                    },
                    {
                      "required": [
                        "password_hash_file"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_uuid",
        "groupname",
        "members"
      ],
      "properties": {
        "attributes": {
          "$ref": "#/$defs/extraAttributes"
        },
        "object_classes": {
          "$ref": "#/$defs/extraObjectClasses"
        },
        "entry_uuid": {
          "$ref": "#/$defs/entryUuid"
        },
        "groupname": {
          "$ref": "#/$defs/username",
          "description": "LDAP cn and the group's naming RDN."
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/username"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true,
          "description": "User entry_uuid or username references, compared case-insensitively. Ambiguous references and repeated users are rejected."
        }
      }
    },
    "bindAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_uuid",
        "username"
      ],
      "properties": {
        "attributes": {
          "$ref": "#/$defs/extraAttributes"
        },
        "object_classes": {
          "$ref": "#/$defs/extraObjectClasses"
        },
        "entry_uuid": {
          "$ref": "#/$defs/entryUuid"
        },
        "username": {
          "$ref": "#/$defs/username"
        },
        "display_name": {
          "$ref": "#/$defs/displayName"
        },
        "password": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_file": {
          "$ref": "#/$defs/credentialPath"
        },
        "password_hash": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_hash_file": {
          "$ref": "#/$defs/credentialPath"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/passwordSource"
        }
      ]
    }
  }
}
