{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundata.com/schemas/openldap-directory-v1.schema.json",
  "title": "One OpenLDAP directory definition (validate after Vault decryption)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "directory_id",
    "base_dn",
    "revision",
    "soft_ttl_seconds",
    "hard_ttl_seconds",
    "input_type"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "directory_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "base_dn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "soft_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "hard_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "expiry_offset_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "input_type": {
      "enum": [
        "users-groups",
        "ldif"
      ]
    },
    "schema_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000\\r\\n]+$"
      },
      "minItems": 0,
      "maxItems": 31,
      "uniqueItems": true
    },
    "read_attributes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^([A-Za-z][A-Za-z0-9-]*|[0-9]+(\\.[0-9]+)+)$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "uuid_namespace": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "users": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/user"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "ldif_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000\\r\\n]+$"
      },
      "minItems": 1,
      "maxItems": 31,
      "uniqueItems": true
    },
    "bind_accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bindAccount"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "input_type": {
          "const": "users-groups"
        }
      },
      "required": [
        "uuid_namespace",
        "organization",
        "users",
        "groups",
        "bind_accounts"
      ],
      "not": {
        "required": [
          "ldif_files"
        ]
      }
    },
    {
      "properties": {
        "input_type": {
          "const": "ldif"
        }
      },
      "required": [
        "ldif_files",
        "read_attributes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "uuid_namespace"
            ]
          },
          {
            "required": [
              "organization"
            ]
          },
          {
            "required": [
              "users"
            ]
          },
          {
            "required": [
              "groups"
            ]
          },
          {
            "required": [
              "bind_accounts"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "credentialValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "credentialPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000\\r\\n]+$"
    },
    "passwordSource": {
      "oneOf": [
        {
          "required": [
            "password"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password_file"
                ]
              },
              {
                "required": [
                  "password_hash"
                ]
              },
              {
                "required": [
                  "password_hash_file"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "password_file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password"
                ]
              },
              {
                "required": [
                  "password_hash"
                ]
              },
              {
                "required": [
                  "password_hash_file"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "password_hash"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password"
                ]
              },
              {
                "required": [
                  "password_file"
                ]
              },
              {
                "required": [
                  "password_hash_file"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "password_hash_file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "password"
                ]
              },
              {
                "required": [
                  "password_file"
                ]
              },
              {
                "required": [
                  "password_hash"
                ]
              }
            ]
          }
        }
      ]
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uid",
        "common_name",
        "surname",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "uid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "common_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "mail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "active": {
          "type": "boolean"
        },
        "password": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_file": {
          "$ref": "#/$defs/credentialPath"
        },
        "password_hash": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_hash_file": {
          "$ref": "#/$defs/credentialPath"
        },
        "given_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP givenName attribute."
        },
        "initials": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP initials attribute."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP displayName attribute."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP description attribute."
        },
        "office": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP physicalDeliveryOfficeName attribute."
        },
        "telephone_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP telephoneNumber attribute."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP ou attribute."
        },
        "job_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "description": "LDAP title attribute."
        },
        "proxy_addresses": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1123,
            "pattern": "^[A-Za-z][A-Za-z0-9]*:[^\\s\\u0000\\r\\n](?:[^\\u0000\\r\\n]*[^\\s\\u0000\\r\\n])?$"
          },
          "description": "Typed recipient addresses; case-insensitive duplicates are rejected."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "active": {
                "const": true
              }
            }
          },
          "then": {
            "$ref": "#/$defs/passwordSource"
          },
          "else": {
            "anyOf": [
              {
                "$ref": "#/$defs/passwordSource"
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "password"
                      ]
                    },
                    {
                      "required": [
                        "password_file"
                      ]
                    },
                    {
                      "required": [
                        "password_hash"
                      ]
                    },
                    {
                      "required": [
                        "password_hash_file"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "common_name",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "common_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        }
      }
    },
    "bindAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "common_name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "common_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "password": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_file": {
          "$ref": "#/$defs/credentialPath"
        },
        "password_hash": {
          "$ref": "#/$defs/credentialValue"
        },
        "password_hash_file": {
          "$ref": "#/$defs/credentialPath"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/passwordSource"
        }
      ]
    }
  }
}
